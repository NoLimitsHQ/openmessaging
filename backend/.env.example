# ---- Veritabanı (zorunlu) ----
# Yerel PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openmessaging?schema=public"
# Ücretsiz bulut alternatifi (Neon / Supabase):
# DATABASE_URL="postgresql://user:pass@ep-xxx.aws.neon.tech/openmessaging?sslmode=require"

# ---- Güvenlik (zorunlu - üretimde mutlaka değiştir) ----
JWT_SECRET="degistir-bu-degeri-rastgele-uzun-bir-secret-yap"
JWT_REFRESH_SECRET="degistir-bunu-da-rastgele-uzun-bir-secret-yap"

# ---- Sunucu ----
PORT=4000
NODE_ENV=development
# Virgülle birden fazla origin verilebilir
CORS_ORIGIN="http://localhost:5173"

# ---- E-posta (opsiyonel) ----
# Boş bırakırsanız Ethereal test hesabı kullanılır ve kod konsola yazılır.
# Gerçek e-posta için bir SMTP sağlayıcı (Gmail app password, Resend, Brevo...) girin.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="OpenMessaging <noreply@openmessaging.local>"

# Geliştirmede doğrulama kodunu konsola yaz (üretimde kapalı tutun).
LOG_OTP="true"
